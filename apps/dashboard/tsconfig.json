{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@app/*": ["./src/app/*"],
            "@features/*": ["./src/features/*"],
            "@shared/*": ["./src/shared/*"]
        },
        "strict": true,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "src/**/*.vue",
        "auto-imports.d.ts",
        "components.d.ts",
        "vite.config.js",
        "vitest.config.ts"
    ]
}
